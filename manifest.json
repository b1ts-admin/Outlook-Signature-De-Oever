{
    "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.24/MicrosoftTeams.schema.json",
    "manifestVersion": "1.24",
    "version": "1.0.0",
    "id": "e777c6a9-69fd-45a2-a6e2-ab14d92a072d",
    "localizationInfo": {
        "defaultLanguageTag": "en-us",
        "additionalLanguages": []
    },
    "developer": {
        "name": "Contoso",
        "websiteUrl": "https://deoever.be",
        "privacyUrl": "https://deoever.be/privacy",
        "termsOfUseUrl": "https://deoever.be/servicesagreement"
    },
    "name": {
        "short": "De Oever - Handtekening",
        "full": "Contoso Task Pane Add-in"
    },
    "description": {
        "short": "A template to get started.",
        "full": "This is the template to get started."
    },
    "icons": {
        "outline": "assets/outline.png",
        "color": "assets/color.png"
    },
    "accentColor": "#230201",
    "validDomains": [
        "contoso.com"
    ],
    "authorization": {
        "permissions": {
            "resourceSpecific": [
                {
                    "name": "MailboxItem.Read.User",
                    "type": "Delegated"
                }
            ]
        }
    },
    "extensions": [
        {
            "requirements": {
                "capabilities": [
                    {
                        "name": "Mailbox",
                        "minVersion": "1.3"
                    }
                ],
                "scopes": [
                    "mail"
                ]
            },
            "runtimes": [
                {
                    "id": "TaskPaneRuntime",
                    "type": "general",
                    "code": {
                        "page": "https://b1ts-admin.github.io/taskpane.html"
                    },
                    "lifetime": "short",
                    "actions": [
                        {
                            "id": "TaskPaneRuntimeShow",
                            "type": "openPage",
                            "pinnable": false
                        }
                    ]
                },
                {
                    "id": "CommandsRuntime",
                    "type": "general",
                    "code": {
                        "page": "https://b1ts-admin.github.io/commands.html"
                    },
                    "lifetime": "short",
                    "actions": [
                        {
                            "id": "action",
                            "type": "executeFunction"
                        }
                    ]
                }
            ],
            "autoRunEvents": [
            {
                "requirements": {
                "capabilities": [
                    {
                    "name": "Mailbox",
                    "minVersion": "1.10"
                    }
                ],
                "scopes": [
                    "mail"
                ]
                },
                "events": [
                {
                    "type": "newMessageComposeCreated",
                    "actionId": "insertSignature"
                },
                {
                    "type": "newAppointmentOrganizerCreated",
                    "actionId": "insertSignature"
                }
                ]
            }
            ],
            "ribbons": [
                {
                    "contexts": [
                        "mailRead"
                    ],
                    "tabs": [
                        {
                            "builtInTabId": "TabDefault",
                            "groups": [
                                {
                                    "id": "msgReadGroup",
                                    "label": "Contoso Add-in",
                                    "icons": [
                                        {
                                            "size": 16,
                                            "url": "https://b1ts-admin.github.io/assets/icon-16.png"
                                        },
                                        {
                                            "size": 32,
                                            "url": "https://b1ts-admin.github.io/assets/icon-32.png"
                                        },
                                        {
                                            "size": 80,
                                            "url": "https://b1ts-admin.github.io/assets/icon-80.png"
                                        }
                                    ],
                                    "controls": [
                                        {
                                            "id": "msgReadOpenPaneButton",
                                            "type": "button",
                                            "label": "Show Task Pane",
                                            "icons": [
                                                {
                                                    "size": 16,
                                                    "url": "https://b1ts-admin.github.io/assets/icon-16.png"
                                                },
                                                {
                                                    "size": 32,
                                                    "url": "https://b1ts-admin.github.io/assets/icon-32.png"
                                                },
                                                {
                                                    "size": 80,
                                                    "url": "https://b1ts-admin.github.io/assets/icon-80.png"
                                                }
                                            ],
                                            "supertip": {
                                                "title": "Show Task Pane",
                                                "description": "Opens a task pane"
                                            },
                                            "actionId": "TaskPaneRuntimeShow"
                                        },
                                        {
                                            "id": "ActionButton",
                                            "type": "button",
                                            "label": "Perform an action",
                                            "icons": [
                                                {
                                                    "size": 16,
                                                    "url": "https://b1ts-admin.github.io/assets/icon-16.png"
                                                },
                                                {
                                                    "size": 32,
                                                    "url": "https://b1ts-admin.github.io/assets/icon-32.png"
                                                },
                                                {
                                                    "size": 80,
                                                    "url": "https://b1ts-admin.github.io/assets/icon-80.png"
                                                }
                                            ],
                                            "supertip": {
                                                "title": "Perform an action",
                                                "description": "Perform an action when clicked."
                                            },
                                            "actionId": "action"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}