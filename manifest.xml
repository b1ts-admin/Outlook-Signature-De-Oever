<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp 
  xmlns="http://microsoft.com" 
  xmlns:xsi="http://w3.org" 
  xmlns:bt="http://microsoft.com" 
  xmlns:mailappor="http://microsoft.com" 
  xsi:type="MailApp">
  
  <Id>ad176d6d-fd5f-4484-a403-8f911f1dcbae</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>De Oever</ProviderName>
  <DefaultLocale>nl-NL</DefaultLocale>
  <DisplayName DefaultValue="De Oever - Handtekening" />
  <Description DefaultValue="Centraal beheerde e-mailhandtekeningen voor De Oever." />
  
  <Hosts>
    <Host xsi:type="MailHost">
      <DesktopFormFactor>
        <FunctionFile resid="Commands.Url" />
        <ExtensionPoint xsi:type="LaunchEvent">
          <LaunchEvents>
            <LaunchEvent Type="OnNewMessageCompose" FunctionName="insertCompanySignature" />
            <LaunchEvent Type="OnNewAppointmentOrganizer" FunctionName="insertCompanySignature" />
          </LaunchEvents>
          <SourceLocation resid="Commands.Url" />
        </ExtensionPoint>
      </DesktopFormFactor>
    </Host>
  </Hosts>
  
  <Permissions>ReadWriteItem</Permissions>
  
  <Resources>
    <bt:Urls>
      <bt:Url id="Commands.Url" DefaultValue="https://github.io"/>
      <bt:Url id="Taskpane.Url" DefaultValue="https://github.io"/>
    </bt:Urls>
  </Resources>
</OfficeApp>